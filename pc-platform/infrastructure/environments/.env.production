# ============================================================
# PC Platform — Production Environment Configuration Template
# ============================================================
# Deployed strictly after manual approval and quality gates.
# All sensitive variables MUST be injected at runtime via
# GitHub Actions Environment Secrets or AWS SSM / Vault / GCP Secret Manager.
# NEVER hardcode secrets or commit actual .env.production files.
# ============================================================

# ─── Environment ─────────────────────────────────────────────
ENVIRONMENT=production
NODE_ENV=production

# ─── Web Application ─────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=https://pcplatform.in
NEXT_PUBLIC_API_URL=https://api.pcplatform.in/api/v1
NEXT_PUBLIC_APP_NAME="PC Platform"
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ─── Admin Backoffice (Strict IP Whitelist & SSO) ────────────
NEXT_PUBLIC_ADMIN_URL=https://admin.pcplatform.in
ADMIN_PORT=3002

# ─── API Service ─────────────────────────────────────────────
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=https://pcplatform.in,https://admin.pcplatform.in
LOG_LEVEL=warn

# ─── Authentication & Secrets (High-Entropy Secrets) ─────────
JWT_SECRET=${PROD_JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=${PROD_JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database (Production PostgreSQL with Read Replicas & SSL) 
DATABASE_URL=${PROD_DATABASE_URL}
DATABASE_MAX_CONNECTIONS=50
DATABASE_IDLE_TIMEOUT=10000

# ─── Cache & Engines (Cluster / Internal VPC only) ───────────
REDIS_URL=${PROD_REDIS_URL}
COMPATIBILITY_ENGINE_URL=https://engine.pcplatform.internal:4001
COMPATIBILITY_ENGINE_API_KEY=${PROD_COMPATIBILITY_ENGINE_API_KEY}

# ─── File Storage (CDN-backed Production Bucket) ─────────────
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=pc-platform-prod-assets
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ACCESS_KEY=${PROD_STORAGE_ACCESS_KEY}
STORAGE_S3_SECRET_KEY=${PROD_STORAGE_SECRET_KEY}
STORAGE_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
CDN_BASE_URL=https://cdn.pcplatform.in

# ─── Email (Production Transactional Mailer) ─────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=${PROD_SMTP_USER}
SMTP_PASS=${PROD_SMTP_PASS}
EMAIL_FROM="PC Platform <noreply@pcplatform.in>"

# ─── Payment Gateway (Production Live Mode Keys) ─────────────
RAZORPAY_KEY_ID=${PROD_RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${PROD_RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${PROD_RAZORPAY_WEBHOOK_SECRET}

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_COMPATIBILITY_STRICT_MODE=true
FEATURE_GUEST_CHECKOUT=false
FEATURE_REVIEWS=true
FEATURE_MAINTENANCE_MODE=false
