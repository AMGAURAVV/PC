# ============================================================
# PC Platform — Development Environment Configuration Template
# ============================================================
# Used for local dev containers and ephemeral PR preview environments
# ============================================================

# ─── Environment ─────────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development

# ─── Web Application ─────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="PC Platform (Dev)"
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ─── Admin Backoffice ────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
ADMIN_PORT=3002

# ─── API Service ─────────────────────────────────────────────
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
LOG_LEVEL=debug

# ─── Authentication & Secrets (Development placeholders) ─────
JWT_SECRET=dev-jwt-secret-not-for-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-not-for-production-key
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pc_platform_dev?schema=public

# ─── Cache & Engines ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
COMPATIBILITY_ENGINE_URL=http://localhost:4001
COMPATIBILITY_ENGINE_API_KEY=dev-internal-api-key-secret

# ─── File Storage ────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# ─── Email ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PC Platform Dev <dev@pcplatform.local>"

# ─── Payment Gateway (Mock / Test Mode Only) ─────────────────
RAZORPAY_KEY_ID=rzp_test_dev_dummy_key_id
RAZORPAY_KEY_SECRET=dev_dummy_secret_never_use_real
RAZORPAY_WEBHOOK_SECRET=dev_dummy_webhook_secret

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_COMPATIBILITY_STRICT_MODE=true
FEATURE_GUEST_CHECKOUT=true
FEATURE_REVIEWS=true
