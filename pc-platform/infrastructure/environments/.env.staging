# ============================================================
# PC Platform — Staging Environment Configuration Template
# ============================================================
# Deployed automatically on merge to main. Mirrors production.
# Secrets are injected from GitHub Environment 'staging' secrets.
# ============================================================

# ─── Environment ─────────────────────────────────────────────
ENVIRONMENT=staging
NODE_ENV=production

# ─── Web Application ─────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=staging
NEXT_PUBLIC_APP_URL=https://staging.pcplatform.in
NEXT_PUBLIC_API_URL=https://api-staging.pcplatform.in/api/v1
NEXT_PUBLIC_APP_NAME="PC Platform (Staging)"
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ─── Admin Backoffice (IP / VPN Gated) ───────────────────────
NEXT_PUBLIC_ADMIN_URL=https://admin-staging.pcplatform.in
ADMIN_PORT=3002

# ─── API Service ─────────────────────────────────────────────
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=https://staging.pcplatform.in,https://admin-staging.pcplatform.in
LOG_LEVEL=info

# ─── Authentication & Secrets (Populated via GitHub Secrets) ─
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=${STAGING_JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database (Staging Managed PostgreSQL) ───────────────────
DATABASE_URL=${STAGING_DATABASE_URL}

# ─── Cache & Engines ─────────────────────────────────────────
REDIS_URL=${STAGING_REDIS_URL}
COMPATIBILITY_ENGINE_URL=https://engine-staging.pcplatform.internal:4001
COMPATIBILITY_ENGINE_API_KEY=${STAGING_COMPATIBILITY_ENGINE_API_KEY}

# ─── File Storage (Cloud Storage / S3 Staging Bucket) ────────
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=pc-platform-staging-assets
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ACCESS_KEY=${STAGING_STORAGE_ACCESS_KEY}
STORAGE_S3_SECRET_KEY=${STAGING_STORAGE_SECRET_KEY}
STORAGE_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# ─── Email (Sandbox / Test Mailer) ───────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=${STAGING_SMTP_USER}
SMTP_PASS=${STAGING_SMTP_PASS}
EMAIL_FROM="PC Platform Staging <staging@pcplatform.in>"

# ─── Payment Gateway (Razorpay Test Mode Only) ───────────────
RAZORPAY_KEY_ID=${STAGING_RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${STAGING_RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${STAGING_RAZORPAY_WEBHOOK_SECRET}

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_COMPATIBILITY_STRICT_MODE=true
FEATURE_GUEST_CHECKOUT=false
FEATURE_REVIEWS=true
