# ============================================================
# PC PLATFORM — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── General ────────────────────────────────────────────────
NODE_ENV=development

# ─── Web App (apps/web) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="PC Platform"

# ─── Admin App (apps/admin) ──────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
ADMIN_PORT=3001

# ─── API (apps/api) ──────────────────────────────────────────
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── JWT Auth ────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pc_platform?schema=public
# For production (Google Cloud SQL / Supabase / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/db_name?schema=public&sslmode=require

# ─── Redis (optional — sessions, rate limiting, cache) ───────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ─── Compatibility Engine ────────────────────────────────────
COMPATIBILITY_ENGINE_URL=http://localhost:4001
COMPATIBILITY_ENGINE_PORT=4001
COMPATIBILITY_ENGINE_API_KEY=change-this-internal-api-key

# ─── File Storage ────────────────────────────────────────────
# Local dev: use disk storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Production: use S3-compatible storage
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com

# ─── Email ───────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM="PC Platform <noreply@pcplatform.in>"

# ─── Payment Gateway (Razorpay — India) ──────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Feature Flags ────────────────────────────────────────────
FEATURE_COMPATIBILITY_STRICT_MODE=true
FEATURE_GUEST_CHECKOUT=false
FEATURE_REVIEWS=true
