{
  "name": "@pc-platform/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma database client and schema for PC Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "generate": "prisma generate && node -e \"const fs=require('fs'); if (fs.existsSync('dist')) { fs.cpSync('src/generated', 'dist/generated', {recursive: true}); }\"",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/generated', 'dist/generated', {recursive: true})\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf src/generated dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@pc-platform/types": "workspace:*",
    "@prisma/client": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prisma": "^5.12.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
