// ──────────────────────────────────────────────────────────────────────────────
// Prisma Schema — PC Platform
// Version: 2.0.0 (full normalized schema)
//
// Single source of truth for the database.
// All changes start here → migrate → generate.
//
// Apply changes:
//   pnpm --filter @pc-platform/database migrate:dev   (create + apply migration)
//   pnpm --filter @pc-platform/database generate       (regenerate Prisma client)
//   pnpm --filter @pc-platform/database seed           (seed demo data)
//
// Conventions:
//   - UUID primary keys on every model
//   - snake_case table/column names via @@map / @map
//   - camelCase Prisma field names
//   - createdAt / updatedAt on every mutable model
//   - Soft delete (deletedAt) where data must be preserved
//   - All monetary values: Decimal(12,2), currency stored as ISO 4217 String
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

// ── User & Auth ───────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// ── Component Types ───────────────────────────────────────────────────────────

enum ComponentType {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
  FAN
  MONITOR
  KEYBOARD
  MOUSE
  HEADSET
  WEBCAM
  SPEAKER
  MICROPHONE
  UPS
  OS
  OTHER
}

// ── Spec Data Types ───────────────────────────────────────────────────────────

enum SpecDataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  JSON_ARRAY
}

// ── Build ─────────────────────────────────────────────────────────────────────

enum BuildStatus {
  DRAFT
  COMPLETE
  ORDERED
  ARCHIVED
}

// ── Compatibility ─────────────────────────────────────────────────────────────

enum CompatibilityRuleType {
  SOCKET_MATCH // e.g. CPU socket must match motherboard socket
  VALUE_RANGE // e.g. PSU wattage >= required wattage
  PHYSICAL_FIT // e.g. GPU length <= case max GPU length
  ENUM_MEMBERSHIP // e.g. RAM type must be in motherboard supported types
  MUTUAL_EXCLUSION // e.g. cannot have two OS components
  CUSTOM // evaluated by compatibility engine from conditions JSON
}

enum CompatibilitySeverity {
  ERROR // build cannot function
  WARNING // build may work but suboptimally
  INFO // informational note
}

// ── Commerce ──────────────────────────────────────────────────────────────────

enum PriceType {
  RETAIL
  SALE
  WHOLESALE
  COST
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  PAYPAL
  COD
  WALLET
}

enum ShippingStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  ATTEMPTED_DELIVERY
  EXCEPTION
  RETURNED
}

// ── Reviews ───────────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// ── Community Showcase & Moderation ──────────────────────────────────────────

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
  REMOVED
}

enum CommunityReportReason {
  INAPPROPRIATE_CONTENT
  MISLEADING_SPECS
  SPAM
  OFFENSIVE_IMAGE
  COPYRIGHT_VIOLATION
  OTHER
}

// ── Admin ─────────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER & AUTH DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(PENDING_VERIFICATION)
  isVerified   Boolean    @default(false) @map("is_verified")
  verifiedAt   DateTime?  @map("verified_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Relations
  userRoles        UserRole[]
  addresses        UserAddress[]
  refreshTokens    RefreshToken[]
  carts            Cart[]
  orders           Order[]
  builds           Build[]
  savedBuilds      SavedBuild[]
  wishlists        Wishlist[]
  reviews          Review[]
  couponUsages     CouponUsage[]
  auditLogsAsActor AuditLog[]     @relation("AuditActor")
  communityBuilds  CommunityBuild[]
  communityLikes   CommunityBuildLike[]
  communityComments CommunityBuildComment[]
  communityReports CommunityBuildReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "super_admin", "admin", "customer", "supplier"
  description String?
  isSystem    Boolean @default(false) @map("is_system") // system roles cannot be deleted

  // Relations
  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g. "products:create", "orders:read", "users:suspend"
  description String?
  module      String // grouping key e.g. "products", "orders", "users"

  // Relations
  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // SHA-256 hash of the raw token
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserAddress {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id")
  type       AddressType @default(HOME)
  label      String? // e.g. "My Home", "Office"
  firstName  String      @map("first_name")
  lastName   String      @map("last_name")
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String      @map("postal_code")
  country    String      @default("IN")
  isDefault  Boolean     @default(false) @map("is_default")
  deletedAt  DateTime?   @map("deleted_at")

  // Relations
  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isDefault])
  @@map("user_addresses")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  websiteUrl  String?   @map("website_url")
  countryCode String?   @map("country_code") // ISO 3166-1 alpha-2
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isActive])
  @@map("brands")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  parentId    String?   @map("parent_id")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")

  // Self-referential tree
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Relations
  productCategories ProductCategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  description      String
  shortDescription String?       @map("short_description")
  sku              String        @unique
  barcode          String?       @unique
  brand            Brand         @relation(fields: [brandId], references: [id])
  brandId          String        @map("brand_id")
  componentType    ComponentType @map("component_type")
  model            String?
  isActive         Boolean       @default(true) @map("is_active")
  isFeatured       Boolean       @default(false) @map("is_featured")
  isDraft          Boolean       @default(false) @map("is_draft")
  weight           Decimal?      @db.Decimal(8, 3) // kg
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  tags             String[] // full-text search tags
  deletedAt        DateTime?     @map("deleted_at")

  // Relations
  categories        ProductCategory[]
  variants          ProductVariant[]
  images            ProductImage[]
  specifications    ProductSpecification[]
  inventory         Inventory[]
  prices            Price[]
  priceHistory      PriceHistory[]
  buildItems        BuildItem[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  powerRequirement  PowerRequirement?
  physicalDimension PhysicalDimension?
  cpuSpec           CpuSpec?
  gpuSpec           GpuSpec?
  motherboardSpec   MotherboardSpec?
  ramSpec           RamSpec?
  storageSpec       StorageSpec?
  psuSpec           PsuSpec?
  caseSpec          CaseSpec?
  coolerSpec        CoolerSpec?
  fanSpec           FanSpec?
  monitorSpec       MonitorSpec?
  peripheralSpec    PeripheralSpec?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([componentType])
  @@index([isActive])
  @@index([isFeatured])
  @@index([slug])
  @@index([sku])
  @@index([deletedAt])
  @@index([isActive, deletedAt, createdAt])
  @@index([isActive, deletedAt, componentType, createdAt])
  @@index([brandId, isActive, deletedAt])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  isPrimary  Boolean  @default(false) @map("is_primary") // one primary category per product

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@map("product_categories")
}

model ProductVariant {
  id         String  @id @default(uuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String  @map("product_id")
  name       String // e.g. "Arctic White", "16GB Kit"
  sku        String  @unique
  barcode    String? @unique
  attributes Json    @default("{}") // { color: "white", capacity: "16GB" }
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  // Relations
  images         ProductImage[]
  inventory      Inventory[]
  prices         Price[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  priceHistories PriceHistory[]
  buildItems     BuildItem[]
  wishlistItems  WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(uuid())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String          @map("product_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?         @map("variant_id")
  url       String
  storageKey String?        @map("storage_key")
  altText   String?         @map("alt_text")
  isPrimary Boolean         @default(false) @map("is_primary")
  width     Int?
  height    Int?
  sizeBytes Int?            @map("size_bytes")
  mimeType  String?         @map("mime_type")
  sortOrder Int             @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

// Generic EAV specification storage (filterable, searchable)
model ProductSpecification {
  id        String       @id @default(uuid())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  key       String // e.g. "cores", "base_clock", "tdp"
  value     String // stored as string, typed by dataType
  dataType  SpecDataType @default(STRING) @map("data_type")
  unit      String? // e.g. "GHz", "W", "MB"
  groupKey  String?      @map("group_key") // e.g. "performance", "physical"
  sortOrder Int          @default(0) @map("sort_order")
  isPublic  Boolean      @default(true) @map("is_public")

  @@unique([productId, key])
  @@index([productId])
  @@index([key])
  @@map("product_specifications")
}

// Component type metadata (admin-managed list of component types and their spec keys)
model ComponentType_Def {
  id          String        @id @default(uuid())
  type        ComponentType @unique
  displayName String        @map("display_name")
  description String?
  iconUrl     String?       @map("icon_url")
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  // Relations
  specDefinitions ComponentSpecDefinition[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("component_type_defs")
}

// Defines the allowed spec keys for each component type (schema-level documentation)
model ComponentSpecDefinition {
  id              String            @id @default(uuid())
  componentType   ComponentType_Def @relation(fields: [componentTypeId], references: [id], onDelete: Cascade)
  componentTypeId String            @map("component_type_id")
  key             String
  label           String // Human-readable label
  dataType        SpecDataType      @default(STRING) @map("data_type")
  unit            String?
  isRequired      Boolean           @default(false) @map("is_required")
  isFilterable    Boolean           @default(false) @map("is_filterable")
  sortOrder       Int               @default(0) @map("sort_order")
  description     String?

  @@unique([componentTypeId, key])
  @@index([componentTypeId])
  @@map("component_spec_definitions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PER-COMPONENT NORMALIZED SPEC TABLES
// ═══════════════════════════════════════════════════════════════════════════════

// CPU Specifications
model CpuSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  socketType        String   @map("socket_type") // e.g. "AM5", "LGA1700"
  architecture      String? // e.g. "Zen 4", "Raptor Lake"
  processTech       String?  @map("process_tech") // e.g. "5nm", "10nm ESF"
  cores             Int
  threads           Int
  baseClockMhz      Int      @map("base_clock_mhz")
  boostClockMhz     Int?     @map("boost_clock_mhz")
  l2CacheMb         Decimal? @map("l2_cache_mb") @db.Decimal(6, 2)
  l3CacheMb         Decimal? @map("l3_cache_mb") @db.Decimal(6, 2)
  tdpW              Int      @map("tdp_w")
  maxTdpW           Int?     @map("max_tdp_w") // PBP vs MTP (Intel) or PPT
  memoryType        String   @map("memory_type") // e.g. "DDR5", "DDR4"
  maxMemoryGb       Int      @map("max_memory_gb")
  maxMemorySpeedMhz Int?     @map("max_memory_speed_mhz")
  memoryChannels    Int      @default(2) @map("memory_channels")
  pcieGen           Int?     @map("pcie_gen") // PCIe lanes generation
  pcieLanes         Int?     @map("pcie_lanes")
  hasIgpu           Boolean  @default(false) @map("has_igpu")
  igpuModel         String?  @map("igpu_model")
  coolerIncluded    Boolean  @default(false) @map("cooler_included")

  @@map("cpu_specs")
}

// GPU Specifications
model GpuSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  chipset         String // e.g. "AD102", "GC-102"
  gpuArchitecture String? @map("gpu_architecture") // e.g. "Ada Lovelace", "RDNA 3"
  processTech     String? @map("process_tech")
  vramGb          Int     @map("vram_gb")
  vramType        String  @map("vram_type") // e.g. "GDDR6X", "GDDR6"
  vramBusBit      Int     @map("vram_bus_bit")
  baseClockMhz    Int?    @map("base_clock_mhz")
  boostClockMhz   Int?    @map("boost_clock_mhz")
  tdpW            Int     @map("tdp_w")
  recommendedPsuW Int?    @map("recommended_psu_w")
  powerConnectors String  @map("power_connectors") // e.g. "1x 16-pin", "2x 8-pin"
  pcieSlot        String  @default("x16") @map("pcie_slot")
  pcieGen         Int     @default(4) @map("pcie_gen")
  slotWidth       Int     @default(2) @map("slot_width") // 2-slot, 3-slot, 4-slot
  lengthMm        Int     @map("length_mm")
  widthMm         Int?    @map("width_mm")
  heightMm        Int?    @map("height_mm")
  displayports    Int     @default(3) @map("displayports")
  hdmiPorts       Int     @default(1) @map("hdmi_ports")
  hdmiVersion     String? @map("hdmi_version")
  dpVersion       String? @map("dp_version")
  hasRaytracing   Boolean @default(false) @map("has_raytracing")
  hasDlss         Boolean @default(false) @map("has_dlss")
  hasFsr          Boolean @default(false) @map("has_fsr")

  @@map("gpu_specs")
}

// Motherboard Specifications
model MotherboardSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  socketType         String   @map("socket_type")
  chipset            String
  formFactor         String   @map("form_factor") // e.g. "ATX", "mATX", "Mini-ITX"
  supportedMemTypes  String[] @map("supported_mem_types") // e.g. ["DDR5"]
  ramSlots           Int      @map("ram_slots")
  maxRamGb           Int      @map("max_ram_gb")
  maxRamSpeedMhz     Int?     @map("max_ram_speed_mhz")
  pcieX16Slots       Int      @default(1) @map("pcie_x16_slots")
  pcieX1Slots        Int      @default(0) @map("pcie_x1_slots")
  m2Slots            Int      @default(1) @map("m2_slots")
  m2Details          Json     @default("[]") @map("m2_details") // [{slot:1, key:"M", pcie:5, sata:false}]
  sataSlots          Int      @default(4) @map("sata_slots")
  usbRearPorts       Json     @default("[]") @map("usb_rear_ports") // [{type:"USB 3.2 Gen2 Type-A", count:4}]
  usbHeaderSlots     Json     @default("[]") @map("usb_header_slots")
  hasWifi            Boolean  @default(false) @map("has_wifi")
  wifiStandard       String?  @map("wifi_standard") // e.g. "Wi-Fi 6E"
  hasBluetooth       Boolean  @default(false) @map("has_bluetooth")
  bluetoothVersion   String?  @map("bluetooth_version")
  hasRgbHeaders      Boolean  @default(false) @map("has_rgb_headers")
  hasArgbHeaders     Boolean  @default(false) @map("has_argb_headers")
  lanChipset         String?  @map("lan_chipset")
  lanSpeedGbps       Decimal? @map("lan_speed_gbps") @db.Decimal(4, 1)
  audioChipset       String?  @map("audio_chipset")
  biosFlashback      Boolean  @default(false) @map("bios_flashback")
  thunderboltSupport Boolean  @default(false) @map("thunderbolt_support")

  @@map("motherboard_specs")
}

// RAM Specifications
model RamSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  memType            String   @map("mem_type") // "DDR4", "DDR5"
  totalCapacityGb    Int      @map("total_capacity_gb")
  stickCount         Int      @default(2) @map("stick_count")
  capacityPerStickGb Int      @map("capacity_per_stick_gb")
  speedMhz           Int      @map("speed_mhz")
  casLatency         Int?     @map("cas_latency")
  timing             String? // e.g. "16-18-18-38"
  voltageV           Decimal? @map("voltage_v") @db.Decimal(4, 3)
  formFactor         String   @default("DIMM") @map("form_factor") // DIMM, SO-DIMM
  isEcc              Boolean  @default(false) @map("is_ecc")
  isRegistered       Boolean  @default(false) @map("is_registered")
  hasHeatspreader    Boolean  @default(false) @map("has_heatspreader")
  hasRgb             Boolean  @default(false) @map("has_rgb")

  @@map("ram_specs")
}

// Storage Specifications
model StorageSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  storageType       String   @map("storage_type") // "NVMe SSD", "SATA SSD", "HDD"
  capacityGb        Int      @map("capacity_gb")
  interface         String // "PCIe 5.0 x4", "SATA III", "PCIe 4.0 x4"
  formFactor        String   @map("form_factor") // "M.2 2280", "2.5\"", "3.5\""
  nandType          String?  @map("nand_type") // "TLC", "QLC", "MLC"
  controller        String? // e.g. "Phison E26"
  seqReadMbps       Int?     @map("seq_read_mbps")
  seqWriteMbps      Int?     @map("seq_write_mbps")
  randRead4kIops    Int?     @map("rand_read_4k_iops")
  randWrite4kIops   Int?     @map("rand_write_4k_iops")
  tbw               Int? // Terabytes Written (endurance)
  mtbfHours         Int?     @map("mtbf_hours")
  rpmSpeed          Int?     @map("rpm_speed") // for HDDs
  cacheGb           Decimal? @map("cache_gb") @db.Decimal(5, 2)
  encryptionSupport Boolean  @default(false) @map("encryption_support")
  dramCache         Boolean  @default(false) @map("dram_cache")

  @@map("storage_specs")
}

// PSU Specifications
model PsuSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  wattage          Int
  efficiencyRating String   @map("efficiency_rating") // "80+ Gold", "80+ Titanium"
  modular          String   @map("modular") // "Full", "Semi", "Non-modular"
  formFactor       String   @default("ATX") @map("form_factor")
  atx12vVersion    String?  @map("atx12v_version") // "ATX 3.0", "ATX 2.4"
  hasAtx3Connector Boolean  @default(false) @map("has_atx3_connector")
  eps12vConnectors Int      @default(1) @map("eps12v_connectors")
  pcieConnectors   Json     @default("[]") @map("pcie_connectors") // [{type:"8-pin",count:4},{type:"16-pin",count:1}]
  sataConnectors   Int      @default(6) @map("sata_connectors")
  molexConnectors  Int      @default(2) @map("molex_connectors")
  fanSizeMm        Int      @default(120) @map("fan_size_mm")
  isZeroFan        Boolean  @default(false) @map("is_zero_fan")
  warrantyYears    Int?     @map("warranty_years")
  protections      String[] // e.g. ["OVP", "OCP", "SCP", "OPP"]

  @@map("psu_specs")
}

// Case Specifications
model CaseSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  caseType             String   @map("case_type") // "Tower", "Mid-Tower", "Full-Tower", "SFF"
  supportedFormFactors String[] @map("supported_form_factors") // ["ATX", "mATX", "Mini-ITX"]
  maxMbFormFactor      String   @map("max_mb_form_factor")
  maxGpuLengthMm       Int      @map("max_gpu_length_mm")
  maxGpuWidthMm        Int?     @map("max_gpu_width_mm")
  maxCpuCoolerHeightMm Int      @map("max_cpu_cooler_height_mm")
  maxPsuLengthMm       Int?     @map("max_psu_length_mm")
  drive35Bays          Int      @default(0) @map("drive_35_bays")
  drive25Bays          Int      @default(0) @map("drive_25_bays")
  pciSlots             Int      @default(7) @map("pci_slots")
  frontPanelUsb        Json     @default("[]") @map("front_panel_usb")
  hasFrontUsbc         Boolean  @default(false) @map("has_front_usbc")
  radiatorSupport      Json     @default("[]") @map("radiator_support") // [{location:"top",maxMm:360},{...}]
  includedFans         Int      @default(0) @map("included_fans")
  maxFans              Int?     @map("max_fans")
  hasGlassPanel        Boolean  @default(false) @map("has_glass_panel")
  hasRgb               Boolean  @default(false) @map("has_rgb")
  dustFilters          Boolean  @default(false) @map("dust_filters")
  widthMm              Int?     @map("width_mm")
  heightMm             Int?     @map("height_mm")
  depthMm              Int?     @map("depth_mm")

  @@map("case_specs")
}

// CPU Cooler Specifications
model CoolerSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  coolerType           String   @map("cooler_type") // "Air", "AIO Liquid", "Custom Loop"
  supportedSockets     String[] @map("supported_sockets") // ["AM5", "LGA1700", "AM4"]
  tdpRatingW           Int      @map("tdp_rating_w")
  heightMm             Int?     @map("height_mm") // for air coolers
  radiatorSizeMm       Int?     @map("radiator_size_mm") // for AIOs: 120, 240, 280, 360
  fanCount             Int      @default(1) @map("fan_count")
  fanSizeMm            Int      @default(120) @map("fan_size_mm")
  maxFanRpm            Int?     @map("max_fan_rpm")
  noiseDbA             Decimal? @map("noise_db_a") @db.Decimal(5, 2)
  hasArgb              Boolean  @default(false) @map("has_argb")
  ramClearanceMm       Int?     @map("ram_clearance_mm")
  includesThermalPaste Boolean  @default(true) @map("includes_thermal_paste")

  @@map("cooler_specs")
}

// Case Fan Specifications
model FanSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  sizeMm                 Int      @map("size_mm") // 80, 92, 120, 140, 200
  minRpm                 Int?     @map("min_rpm")
  maxRpm                 Int      @map("max_rpm")
  maxAirflowCfm          Decimal? @map("max_airflow_cfm") @db.Decimal(6, 2)
  maxStaticPressureMmH2o Decimal? @map("max_static_pressure_mm_h2o") @db.Decimal(5, 2)
  maxNoiseDbA            Decimal? @map("max_noise_db_a") @db.Decimal(5, 2)
  bearingType            String?  @map("bearing_type") // "Fluid Dynamic", "Rifle", "Ball"
  connector              String   @default("4-pin PWM") // "4-pin PWM", "3-pin DC", "3-pin ARGB"
  isPwm                  Boolean  @default(true) @map("is_pwm")
  hasArgb                Boolean  @default(false) @map("has_argb")
  hasRgb                 Boolean  @default(false) @map("has_rgb")
  ledColor               String?  @map("led_color")
  packCount              Int      @default(1) @map("pack_count") // sold as 3-pack etc.

  @@map("fan_specs")
}

// Monitor Specifications
model MonitorSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  screenSizeInch     Decimal  @map("screen_size_inch") @db.Decimal(4, 1)
  resolutionW        Int      @map("resolution_w")
  resolutionH        Int      @map("resolution_h")
  panelType          String   @map("panel_type") // "IPS", "VA", "TN", "OLED", "Mini-LED"
  refreshRateHz      Int      @map("refresh_rate_hz")
  responseTimeMs     Decimal? @map("response_time_ms") @db.Decimal(4, 2)
  brightness         Int? // nits
  contrastRatio      String?  @map("contrast_ratio")
  colorGamutPercent  Json     @default("{}") @map("color_gamut_percent") // {sRGB: 99, DCI_P3: 90}
  hdrSupport         String?  @map("hdr_support") // "HDR400", "HDR1000", null
  adaptiveSyncType   String?  @map("adaptive_sync_type") // "G-Sync", "FreeSync Premium", "G-Sync Compatible"
  ports              Json     @default("[]") @map("ports") // [{type:"HDMI 2.1",count:2},{type:"DP 1.4",count:1}]
  hasBuiltinSpeakers Boolean  @default(false) @map("has_builtin_speakers")
  hasUsbHub          Boolean  @default(false) @map("has_usb_hub")
  vesa               String? // "100x100", "75x75"
  curvatureMm        Int?     @map("curvature_mm")
  aspectRatio        String?  @map("aspect_ratio") // "16:9", "21:9", "32:9"

  @@map("monitor_specs")
}

// Peripheral Specifications (keyboard, mouse, headset, etc.)
model PeripheralSpec {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique @map("product_id")

  peripheralType   ComponentType @map("peripheral_type") // KEYBOARD, MOUSE, HEADSET, etc.
  connectivity     String[] // ["USB", "Bluetooth 5.2", "2.4GHz Wireless"]
  isWireless       Boolean       @default(false) @map("is_wireless")
  batteryMah       Int?          @map("battery_mah")
  batteryLifeHours Int?          @map("battery_life_hours")
