  // Keyboard-specific
  switchType       String?       @map("switch_type") // "Cherry MX Red", "Optical", "Membrane"
  keyLayout        String?       @map("key_layout") // "Full-size", "TKL", "75%", "60%"
  isHotSwap        Boolean       @default(false) @map("is_hot_swap")
  // Mouse-specific
  maxDpi           Int?          @map("max_dpi")
  buttonCount      Int?          @map("button_count")
  sensorType       String?       @map("sensor_type") // "Optical", "Laser"
  // Headset-specific
  driverSizeMm     Int?          @map("driver_size_mm")
  frequencyHz      String?       @map("frequency_hz") // e.g. "20-20000 Hz"
