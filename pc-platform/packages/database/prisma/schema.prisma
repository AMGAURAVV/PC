  surroundSound    String?       @map("surround_sound") // "7.1", "Stereo"

  @@map("peripheral_specs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVENTORY & SUPPLIER DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Supplier {
  id         String    @id @default(uuid())
  name       String    @unique
  code       String    @unique // Short code e.g. "MDK", "PRIME"
  email      String?
  phone      String?
  website    String?
  address    Json? // free-form address JSON
  isActive   Boolean   @default(true) @map("is_active")
  isPlatform Boolean   @default(false) @map("is_platform") // true = the platform itself
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  inventory    Inventory[]
  priceHistory PriceHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("suppliers")
}

model Inventory {
  id                String          @id @default(uuid())
  product           Product         @relation(fields: [productId], references: [id])
  productId         String          @map("product_id")
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  variantId         String?         @map("variant_id")
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  supplierId        String          @map("supplier_id")
  quantity          Int             @default(0)
  reservedQty       Int             @default(0) @map("reserved_qty") // qty reserved in pending orders
  lowStockThreshold Int             @default(5) @map("low_stock_threshold")
  isInfinite        Boolean         @default(false) @map("is_infinite") // digital/unlimited products
  locationCode      String?         @map("location_code") // warehouse bin/location

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, variantId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@index([quantity])
  @@map("inventory")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRICING DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Price {
  id        String          @id @default(uuid())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String          @map("product_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id")
  priceType PriceType       @default(RETAIL) @map("price_type")
  amount    Decimal         @db.Decimal(12, 2)
  currency  String          @default("INR") // ISO 4217
  compareAt Decimal?        @map("compare_at") @db.Decimal(12, 2) // original price for sale display
  isActive  Boolean         @default(true) @map("is_active")
  startsAt  DateTime?       @map("starts_at")
  endsAt    DateTime?       @map("ends_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, variantId, priceType, currency])
  @@index([productId])
  @@index([variantId])
  @@index([currency])
  @@index([isActive])
  @@index([productId, isActive])
  @@map("prices")
}

model PriceHistory {
  id               String          @id @default(uuid())
  product          Product         @relation(fields: [productId], references: [id])
  productId        String          @map("product_id")
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  variantId        String?         @map("variant_id")
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  supplierId       String?         @map("supplier_id")
  priceType        PriceType       @default(RETAIL) @map("price_type")
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  source           String          @default("ADMIN_UPDATE") @map("source")
  effectiveDate    DateTime        @default(now()) @map("effective_date")
  endDate          DateTime?       @map("end_date")
  changedBy        String?         @map("changed_by") // admin userId or "system"
  reason           String?         // e.g. "Seasonal sale"

  // Administrative correction audit trail
  isCorrection     Boolean         @default(false) @map("is_correction")
  originalAmount   Decimal?        @map("original_amount") @db.Decimal(12, 2)
  correctionReason String?         @map("correction_reason")
  correctedBy      String?         @map("corrected_by")
  correctedAt      DateTime?       @map("corrected_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@index([productId, effectiveDate])
  @@index([variantId, effectiveDate])
  @@map("price_history")
}

// ═══════════════════════════════════════════════════════════════════════════════
// BUILD DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Build {
  id              String      @id @default(uuid())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String      @map("user_id")
  name            String      @default("My Build")
  description     String?
  status          BuildStatus @default(DRAFT)
  isPublic        Boolean     @default(false) @map("is_public")
  thumbnailUrl    String?     @map("thumbnail_url")
  totalPriceCache Decimal?    @map("total_price_cache") @db.Decimal(12, 2) // denormalized, recomputed on item change
  deletedAt       DateTime?   @map("deleted_at")

  // Relations
  items       BuildItem[]
  savedBy     SavedBuild[]
  versions    BuildVersion[]
  sharedLinks SharedBuildLink[]
  orders      Order[]
  communityBuild CommunityBuild?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isPublic])
  @@index([status])
  @@index([deletedAt])
  @@index([userId, deletedAt, createdAt])
  @@map("builds")
}

model BuildItem {
  id            String          @id @default(uuid())
  build         Build           @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId       String          @map("build_id")
  product       Product         @relation(fields: [productId], references: [id])
  productId     String          @map("product_id")
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  variantId     String?         @map("variant_id")
  componentType ComponentType   @map("component_type") // denormalized for quick filtering
  quantity      Int             @default(1)
  sortOrder     Int             @default(0) @map("sort_order")
  priceSnapshot Decimal?        @map("price_snapshot") @db.Decimal(12, 2) // price at time of adding
  notes         String? // user notes on this item

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([buildId])
  @@index([productId])
  @@index([componentType])
  @@map("build_items")
}

model SavedBuild {
  id      String @id @default(uuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String @map("build_id")

  savedAt DateTime @default(now()) @map("saved_at")

  @@unique([userId, buildId])
  @@index([userId])
  @@map("saved_builds")
}

model BuildVersion {
  id            String  @id @default(uuid())
  build         Build   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId       String  @map("build_id")
  versionNumber Int     @map("version_number")
  label         String? // e.g. "Before GPU upgrade"
  snapshot      Json // full snapshot of build + items at this version
  createdBy     String? @map("created_by") // userId

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([buildId, versionNumber])
  @@index([buildId])
  @@map("build_versions")
}

model SharedBuildLink {
  id        String    @id @default(uuid())
  build     Build     @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId   String    @map("build_id")
  token     String    @unique // random URL-safe token
  label     String? // optional label e.g. "Shared with friend"
  expiresAt DateTime? @map("expires_at")
  viewCount Int       @default(0) @map("view_count")
  maxViews  Int?      @map("max_views") // null = unlimited
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([buildId])
  @@map("shared_build_links")
}

model BuildTemplate {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  category     String? // e.g. "Gaming", "Workstation", "Budget"
  budgetMin    Decimal? @map("budget_min") @db.Decimal(12, 2)
  budgetMax    Decimal? @map("budget_max") @db.Decimal(12, 2)
  items        Json // [{productId, componentType, quantity, notes}]
  thumbnailUrl String?  @map("thumbnail_url")
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String?  @map("created_by") // admin userId

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isFeatured])
  @@map("build_templates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// COMPATIBILITY DOMAIN
// (Data only — evaluation logic lives in the compatibility-engine service)
// ═══════════════════════════════════════════════════════════════════════════════

model CompatibilityRule {
  id          String                @id @default(uuid())
  name        String                @unique
  description String
  ruleType    CompatibilityRuleType @map("rule_type")
  severity    CompatibilitySeverity @default(ERROR)
  isActive    Boolean               @default(true) @map("is_active")
  priority    Int                   @default(100) // lower = evaluated first
  tags        String[] // e.g. ["cpu", "socket", "motherboard"]
  notes       String? // Internal notes for rule authors

  // Relations
  conditions CompatibilityRuleCondition[]
  result     CompatibilityRuleResult?
  warnings   CompatibilityWarning[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([ruleType])
  @@index([severity])
  @@map("compatibility_rules")
}

// Conditions that must ALL be true for the rule to apply/trigger
model CompatibilityRuleCondition {
  id                     String            @id @default(uuid())
  rule                   CompatibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId                 String            @map("rule_id")
  conditionIndex         Int               @map("condition_index") // ordering within rule
  // Which component to inspect
  componentType          ComponentType     @map("component_type")
  // JSON path into the spec table row e.g. "socketType", "tdpW", "supportedSockets"
  attributePath          String            @map("attribute_path")
  // Comparison operator
  operator               String // "eq", "ne", "gt", "gte", "lt", "lte", "in", "contains", "matches"
  // The reference value (compared against the other component's attribute)
  compareToComponentType ComponentType?    @map("compare_to_component_type")
  compareToAttributePath String?           @map("compare_to_attribute_path")
  // Or a literal value
  literalValue           String?           @map("literal_value")

  @@index([ruleId])
  @@map("compatibility_rule_conditions")
}

// What the rule produces when conditions are met
model CompatibilityRuleResult {
  id               String            @id @default(uuid())
  rule             CompatibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId           String            @unique @map("rule_id")
  title            String // Short title e.g. "CPU/Motherboard socket mismatch"
  message          String // Full user-facing message template (supports {{CPU.socketType}} placeholders)
  suggestion       String? // Suggested fix e.g. "Select a motherboard with AM5 socket"
  documentationUrl String?           @map("documentation_url")

  @@map("compatibility_rule_results")
}

// Per-build evaluated warnings stored for display (not re-evaluated every time)
model CompatibilityWarning {
  id         String                @id @default(uuid())
  buildId    String                @map("build_id") // Not FK — builds may be deleted
  rule       CompatibilityRule     @relation(fields: [ruleId], references: [id])
  ruleId     String                @map("rule_id")
  severity   CompatibilitySeverity
  title      String
  message    String
  resolvedAt DateTime?             @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([buildId])
  @@index([ruleId])
  @@map("compatibility_warnings")
}

// Per-product power draw data (feeds PSU adequacy check)
model PowerRequirement {
  id          String  @id @default(uuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String  @unique @map("product_id")
  idleW       Int?    @map("idle_w")
  typicalW    Int     @map("typical_w")
  peakW       Int     @map("peak_w")
  sourceNotes String? @map("source_notes") // e.g. "Measured at wall per TechPowerUp review"

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("power_requirements")
}

// Per-product physical clearance data (feeds physical fit checks)
model PhysicalDimension {
  id              String   @id @default(uuid())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String   @unique @map("product_id")
  lengthMm        Decimal? @map("length_mm") @db.Decimal(7, 2)
  widthMm         Decimal? @map("width_mm") @db.Decimal(7, 2)
  heightMm        Decimal? @map("height_mm") @db.Decimal(7, 2)
  weightG         Decimal? @map("weight_g") @db.Decimal(8, 2)
  // Clearance requirements (for components that need space)
  clearanceTopMm  Int?     @map("clearance_top_mm") // e.g. cooler needs clearance from top panel
  clearanceSideMm Int?     @map("clearance_side_mm")
  notes           String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("physical_dimensions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// COUPON DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Coupon {
  id                      String     @id @default(uuid())
  code                    String     @unique
  description             String?
  couponType              CouponType @map("coupon_type")
  value                   Decimal    @db.Decimal(10, 2) // percentage or fixed amount
  minOrderAmount          Decimal?   @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount       Decimal?   @map("max_discount_amount") @db.Decimal(12, 2) // cap on percentage coupons
  currency                String     @default("INR")
  usageLimit              Int?       @map("usage_limit") // null = unlimited
  usagePerUser            Int?       @map("usage_per_user") // null = unlimited
  usageCount              Int        @default(0) @map("usage_count")
  isActive                Boolean    @default(true) @map("is_active")
  startsAt                DateTime?  @map("starts_at")
  expiresAt               DateTime?  @map("expires_at")
  // Eligibility filters
  applicableToProductIds  String[]   @map("applicable_to_product_ids") // empty = all products
  applicableToCategoryIds String[]   @map("applicable_to_category_ids")

  // Relations
  usages CouponUsage[]
  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id       String @id @default(uuid())
  coupon   Coupon @relation(fields: [couponId], references: [id])
  couponId String @map("coupon_id")
  user     User   @relation(fields: [userId], references: [id])
  userId   String @map("user_id")
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String @map("order_id")

  usedAt DateTime @default(now()) @map("used_at")

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CART DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Cart {
  id           String    @id @default(uuid())
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?   @map("user_id") // null = guest cart
  sessionToken String?   @unique @map("session_token") // guest session identifier
  expiresAt    DateTime? @map("expires_at") // guest carts expire
  currency     String    @default("INR")

  // Relations
  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sessionToken])
  @@map("carts")
}

model CartItem {
  id            String          @id @default(uuid())
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId        String          @map("cart_id")
  product       Product         @relation(fields: [productId], references: [id])
  productId     String          @map("product_id")
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  variantId     String?         @map("variant_id")
  quantity      Int             @default(1)
  savedForLater Boolean         @default(false) @map("saved_for_later")

  addedAt   DateTime @default(now()) @map("added_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ORDER DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique @map("order_number") // human-readable e.g. "PCP-2024-00001"
  user               User        @relation(fields: [userId], references: [id])
  userId             String      @map("user_id")
  build              Build?      @relation(fields: [buildId], references: [id])
  buildId            String?     @map("build_id")
  shippingAddress    UserAddress @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId  String      @map("shipping_address_id")
  coupon             Coupon?     @relation(fields: [couponId], references: [id])
  couponId           String?     @map("coupon_id")
  status             OrderStatus @default(PENDING)
  currency           String      @default("INR")
  subtotal           Decimal     @db.Decimal(12, 2)
  discountAmount     Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingCost       Decimal     @map("shipping_cost") @db.Decimal(12, 2)
  taxAmount          Decimal     @map("tax_amount") @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  notes              String?
  cancelledAt        DateTime?   @map("cancelled_at")
  cancellationReason String?     @map("cancellation_reason")

  // Relations
  items       OrderItem[]
  payments    Payment[]
  shipments   Shipment[]
  couponUsage CouponUsage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String          @map("order_id")
  product     Product         @relation(fields: [productId], references: [id])
  productId   String          @map("product_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   String?         @map("variant_id")
  // Snapshot fields (immutable after order placed)
  productName String          @map("product_name")
  variantName String?         @map("variant_name")
  sku         String
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(12, 2)
  currency    String          @default("INR")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid())
  order             Order           @relation(fields: [orderId], references: [id])
  orderId           String          @map("order_id")
  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id")
  providerOrderId   String?         @map("provider_order_id")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?       @map("paid_at")
  failureReason     String?         @map("failure_reason")
  refundedAmount    Decimal?        @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt        DateTime?       @map("refunded_at")
  metadata          Json? // raw provider webhook payload

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SHIPPING DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Shipment {
  id                  String         @id @default(uuid())
  order               Order          @relation(fields: [orderId], references: [id])
  orderId             String         @map("order_id")
  carrier             String? // e.g. "BlueDart", "DTDC", "FedEx"
  trackingNumber      String?        @unique @map("tracking_number")
  trackingUrl         String?        @map("tracking_url")
  status              ShippingStatus @default(PENDING)
  shippedAt           DateTime?      @map("shipped_at")
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at")
  deliveredAt         DateTime?      @map("delivered_at")
  notes               String?

  // Relations
  events ShipmentEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(uuid())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String         @map("shipment_id")
  status      ShippingStatus
  location    String?
  description String?
  occurredAt  DateTime       @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("shipment_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// REVIEWS & UGC DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Review {
  id                 String       @id @default(uuid())
  product            Product      @relation(fields: [productId], references: [id])
  productId          String       @map("product_id")
  user               User         @relation(fields: [userId], references: [id])
  userId             String       @map("user_id")
  rating             Int // 1-5
  title              String?
  body               String?
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  helpfulCount       Int          @default(0) @map("helpful_count")
  notHelpfulCount    Int          @default(0) @map("not_helpful_count")
  moderatorNote      String?      @map("moderator_note")
  deletedAt          DateTime?    @map("deleted_at")

  // Relations
  images ReviewImage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId]) // one review per user per product
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([productId, deletedAt, createdAt])
  @@map("reviews")
}

model ReviewImage {
  id        String  @id @default(uuid())
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String  @map("review_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reviewId])
  @@map("review_images")
}

model Wishlist {
  id        String  @id @default(uuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  name      String  @default("My Wishlist")
  isDefault Boolean @default(false) @map("is_default")
  isPublic  Boolean @default(false) @map("is_public")

  // Relations
  items WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String          @id @default(uuid())
  wishlist   Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId String          @map("wishlist_id")
  product    Product         @relation(fields: [productId], references: [id])
  productId  String          @map("product_id")
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantId  String?         @map("variant_id")
  notes      String?

  addedAt DateTime @default(now()) @map("added_at")

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ADMIN AUDIT LOG
// ═══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id          String      @id @default(uuid())
  actor       User?       @relation("AuditActor", fields: [actorId], references: [id])
  actorId     String?     @map("actor_id") // null = system action
  actorEmail  String?     @map("actor_email") // snapshot in case user is deleted
  action      AuditAction
  entityType  String      @map("entity_type") // e.g. "Product", "Order", "User"
  entityId    String?     @map("entity_id")
  entityLabel String?     @map("entity_label") // human-readable snapshot e.g. product name
  before      Json? // state before change (null for CREATE)
  after       Json? // state after change (null for DELETE)
  metadata    Json? // additional context (IP, user agent, etc.)
  ipAddress   String?     @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CMS & HOMEPAGE CONTENT DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model Banner {
  id             String    @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String    @map("image_url")
  mobileImageUrl String?   @map("mobile_image_url")
  linkUrl        String?   @map("link_url")
  position       String    @default("hero") // hero, promo_top, promo_bottom, sidebar
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([position, isActive])
  @@map("banners")
}

model HomepageSection {
  id         String   @id @default(uuid())
  title      String
  sectionKey String   @unique @map("section_key") // e.g. "hero_carousel", "featured_products", "deals_of_day", "top_categories"
  type       String   // banner_slider, product_grid, category_grid, text_block
  config     Json?    // settings, query filters, item IDs
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("homepage_sections")
}

// ═══════════════════════════════════════════════════════════════════════════════
// COMMUNITY BUILD SHOWCASE & MODERATION DOMAIN
// ═══════════════════════════════════════════════════════════════════════════════

model CommunityBuild {
  id                   String           @id @default(uuid())
  slug                 String           @unique
  name                 String
  description          String?
  useCase              String           @default("Gaming") @map("use_case")
  totalPrice           Decimal          @default(0) @map("total_price") @db.Decimal(12, 2)
  currency             String           @default("INR")
  cpuName              String?          @map("cpu_name")
  gpuName              String?          @map("gpu_name")
  motherboardName      String?          @map("motherboard_name")
  ramInfo              String?          @map("ram_info")
  storageInfo          String?          @map("storage_info")
  caseName             String?          @map("case_name")
  psuInfo              String?          @map("psu_info")
  coolerName           String?          @map("cooler_name")
  images               String[]
  components           Json             @default("[]") // [{productId, name, componentType, price, quantity, specs, imageUrl}]
  compatibilitySummary Json?            @map("compatibility_summary") // { status, estimatedWattage, recommendedPsuW, warnings, notes }
  authorId             String           @map("author_id")
  author               User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  buildId              String?          @unique @map("build_id")
  build                Build?           @relation(fields: [buildId], references: [id], onDelete: SetNull)
  isFeatured           Boolean          @default(false) @map("is_featured")
  moderationStatus     ModerationStatus @default(APPROVED) @map("moderation_status")
  viewCount            Int              @default(0) @map("view_count")
  likeCount            Int              @default(0) @map("like_count")
  commentCount         Int              @default(0) @map("comment_count")
  moderatorNotes       String?          @map("moderator_notes")
  moderatedAt          DateTime?        @map("moderated_at")
  moderatedBy          String?          @map("moderated_by")
  publishedAt          DateTime         @default(now()) @map("published_at")

  // Relations
  likes    CommunityBuildLike[]
  comments CommunityBuildComment[]
  reports  CommunityBuildReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isFeatured])
  @@index([moderationStatus])
  @@index([useCase])
  @@index([totalPrice])
  @@index([authorId])
  @@index([publishedAt])
  @@index([moderationStatus, publishedAt])
  @@index([moderationStatus, likeCount])
  @@index([moderationStatus, isFeatured])
  @@index([moderationStatus, totalPrice])
  @@map("community_builds")
}

model CommunityBuildLike {
  id        String         @id @default(uuid())
  build     CommunityBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId   String         @map("build_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([buildId, userId])
  @@index([buildId])
  @@index([userId])
  @@map("community_build_likes")
}

model CommunityBuildComment {
  id          String         @id @default(uuid())
  build       CommunityBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId     String         @map("build_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String         @map("user_id")
  content     String
  isModerated Boolean        @default(false) @map("is_moderated")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([buildId])
  @@index([userId])
  @@map("community_build_comments")
}

model CommunityBuildReport {
  id         String                @id @default(uuid())
  build      CommunityBuild        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId    String                @map("build_id")
  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?               @map("user_id")
  reporterEmail String?            @map("reporter_email")
  reason     CommunityReportReason
  details    String?
  status     String                @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTIONED
  resolvedAt DateTime?             @map("resolved_at")
  resolvedBy String?               @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([buildId])
  @@index([status])
  @@index([userId])
  @@map("community_build_reports")
}

