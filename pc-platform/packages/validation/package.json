{
  "name": "@pc-platform/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod validation schemas for PC Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node ../../node_modules/.pnpm/node_modules/jest/bin/jest.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pc-platform/types": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
